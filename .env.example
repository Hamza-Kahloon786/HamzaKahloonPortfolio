# Your production domain — used for canonical URLs, sitemap, Open Graph, JSON-LD and llms.txt.
# On Vercel this falls back to the project's production URL automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Google Search Console verification token (content of the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: a GitHub token (no scopes needed) raises the API rate limit for the live GitHub panel.
GITHUB_TOKEN=

# ── AI assistant ("Ask my AI": voice + text chat) ─────────────────────────────
# Server-only. The assistant only appears on the site when this is set.
# Use a dedicated OpenAI *project* key and set a monthly budget limit on that project.
OPENAI_API_KEY=

# Optional model overrides (defaults shown).
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_CHAT_MODEL=gpt-6-luna
